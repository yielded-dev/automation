{
  // Disposable native probe. Deployment and account resources belong to the host.
  // Supply a fresh 64-character lowercase hex ISOLATION_TEST_TOKEN secret separately.
  "name": "repairs-inactivity-isolation",
  "main": "inactivity.worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    // Managed base: no Dockerfile, build, upload, or new image publication.
    "ISOLATION_IMAGE": "cloudflare/debian-trixie",
  },
  "durable_objects": {
    "bindings": [{ "name": "PROBE", "class_name": "InactivityProbe" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InactivityProbe"] }],
  "containers": [
    {
      "name": "repairs-inactivity-isolation",
      "class_name": "InactivityProbe",
      "scheduling_policy": "durable_object",
      "observability": { "logs": { "enabled": true } },
    },
  ],
  // A real binding; this installed Miniflare version still rejects local calls.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "repairs-inactivity" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
