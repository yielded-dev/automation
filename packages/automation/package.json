{
  "name": "@yielded/automation",
  "version": "0.6.1",
  "description": "Event investigation, decision reuse and authorized action workflows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yielded-dev/automation.git",
    "directory": "packages/automation"
  },
  "files": [
    "CHANGELOG.md",
    "src",
    "dist",
    "docs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./github": {
      "types": "./src/github.ts",
      "default": "./dist/github.mjs"
    },
    "./domain": {
      "types": "./src/domain.ts",
      "default": "./dist/domain.mjs"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.mjs"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./dist/client.mjs"
    },
    "./cloudflare": {
      "types": "./src/cloudflare.ts",
      "default": "./dist/cloudflare.mjs"
    },
    "./domain/*": {
      "types": "./src/domain/*.ts",
      "default": "./dist/domain/*.mjs"
    },
    "./server/*": {
      "types": "./src/server/*.ts",
      "default": "./dist/server/*.mjs"
    },
    "./postgres": {
      "types": "./src/postgres.ts",
      "default": "./dist/postgres.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp run build",
    "test": "vp test --run",
    "test:e2e": "node test/e2e/inspect.mjs",
    "test:e2e:github": "node test/e2e/github.mjs",
    "test:e2e:publication": "node test/e2e/publication.mjs"
  },
  "dependencies": {
    "@xstate/effect": "0.1.0-alpha.4",
    "uuid": "14.0.1",
    "xstate": "6.0.0-alpha.61"
  },
  "devDependencies": {
    "@yielded/sandbox": "workspace:*"
  },
  "peerDependencies": {
    "@yielded/sandbox": "^0.6.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "effect": "^4.0.3",
    "effect-cf": "^0.56.2"
  },
  "peerDependenciesMeta": {
    "@yielded/sandbox": {
      "optional": true
    },
    "effect-cf": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  }
}
