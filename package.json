{
  "name": "yielded-automation-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./packages/automation/src/index.ts",
      "default": "./packages/automation/dist/index.mjs"
    },
    "./github": {
      "types": "./packages/automation/src/github.ts",
      "default": "./packages/automation/dist/github.mjs"
    },
    "./domain": {
      "types": "./packages/automation/src/domain.ts",
      "default": "./packages/automation/dist/domain.mjs"
    },
    "./server": {
      "types": "./packages/automation/src/server.ts",
      "default": "./packages/automation/dist/server.mjs"
    },
    "./client": {
      "types": "./packages/automation/src/client.ts",
      "default": "./packages/automation/dist/client.mjs"
    },
    "./cloudflare": {
      "types": "./packages/automation/src/cloudflare.ts",
      "default": "./packages/automation/dist/cloudflare.mjs"
    },
    "./domain/*": {
      "types": "./packages/automation/src/domain/*.ts",
      "default": "./packages/automation/dist/domain/*.mjs"
    },
    "./server/*": {
      "types": "./packages/automation/src/server/*.ts",
      "default": "./packages/automation/dist/server/*.mjs"
    },
    "./postgres": {
      "types": "./packages/automation/src/postgres.ts",
      "default": "./packages/automation/dist/postgres.mjs"
    },
    "./package.json": "./packages/automation/package.json"
  },
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "ci:version": "vp run changeset:version && vp install --ignore-scripts",
    "release:publish": "changeset publish",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --type-check",
    "check": "vp fmt --check && vp lint && vp run typecheck && vp run build && vp run test",
    "check:packages": "node scripts/check-packages.mjs",
    "build": "vp run -r build",
    "test": "vp run -r test && vp run test:postgres",
    "test:postgres": "vp test run test/integration/Deduplication.test.ts",
    "test:integration": "node test/integration/launch.mjs",
    "prepare": "vp -C packages/automation run build"
  },
  "dependencies": {
    "@xstate/effect": "0.1.0-alpha.4",
    "publint": "0.3.25",
    "uuid": "14.0.1",
    "vite-plus": "1.1.0",
    "xstate": "6.0.0-alpha.61"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@cloudflare/workers-types": "5.20261026.1",
    "@effect/platform-node": "4.1.0",
    "@effect/sql-d1": "4.1.0",
    "@effect/sql-pg": "4.1.0",
    "@effect/sql-sqlite-do": "4.1.0",
    "@types/node": "26.1.2",
    "@yielded/automation": "workspace:*",
    "@yielded/effect-tsrs": "0.2.2",
    "@yielded/sandbox": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.1.0",
    "effect-cf": "0.59.0",
    "miniflare": "5.20261006.1-alpha",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "peerDependencies": {
    "@yielded/sandbox": "^0.8.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "effect": "^4.1.0",
    "effect-cf": "^0.59.0"
  },
  "peerDependenciesMeta": {
    "@yielded/sandbox": {
      "optional": true
    },
    "effect-cf": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    }
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.0",
    "@effect/sql-d1": "4.1.0",
    "@effect/sql-sqlite-do": "4.1.0",
    "effect": "4.1.0"
  },
  "packageManager": "bun@1.4.2"
}
